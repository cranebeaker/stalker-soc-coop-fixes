local function emit(n, first, second)
	local e = T[n]
	if e == nil then return end
	pcall(function() coop_pda_phrases.phrase_speaker[e[1]] = e[2] end)
	pcall(function() coop_pda_archive_sync.emit_phrase(first, second, e[1]) end)
end

